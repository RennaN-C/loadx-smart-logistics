root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,html,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{ini,toml,cfg}]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
