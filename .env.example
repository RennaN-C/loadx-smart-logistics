APP_ENV=local
OPERATIONAL_LOG_LEVEL=INFO
OPERATIONAL_REQUEST_LOGS=true
POSTGRES_DB=loadx
POSTGRES_USER=loadx
# CONFIRMADO: preencha somente no .env local, que não deve ser versionado.
# Para um banco novo, gere uma senha hexadecimal com: openssl rand -hex 24
# Para um volume existente, mantenha a senha já configurada no PostgreSQL.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql+psycopg://loadx_test:loadx_test_local@127.0.0.1:55432/loadx_test
TEST_POSTGRES_PORT=55432
BACKEND_CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8000
SECRET_KEY=troque-esta-chave-no-env-local
LOADX_SECRETS_DIR=
PASSWORD_BLOCKLIST_PATH=
EVIDENCE_STORAGE_DIR=
AI_PROVIDER=mock
AI_EXPLANATION_TIMEOUT_SECONDS=5
# OC82: somente mock nesta etapa; integração real adiada.
WHATSAPP_PROVIDER=mock
# OC83: emissor HTTP controlado opt-in; não é webhook Meta.
INBOUND_WEBHOOK_ENABLED=false
INBOUND_WEBHOOK_BINDINGS={}
INBOUND_WEBHOOK_CAPABILITIES=[]
# INBOUND_WEBHOOK_SIGNING_KEY vem do ambiente seguro, sem valor padrão.
VITE_API_URL=/api/v1
DEV_API_PROXY_TARGET=http://localhost:8000
# Normalmente vazio; use somente em desenvolvimento atrás de túnel/reverse proxy.
DEV_API_PROXY_ORIGIN=
FRONTEND_PORT=5173

# OC98: chave Fernet independente; forneça por cofre, nunca versione valor real.
MFA_ENCRYPTION_KEY=
# Recuperação desabilitada por padrão; SMTP/Mailpit ou Resend HTTPS.
# Em hospedagem que bloqueia SMTP, configure provider=resend no cofre do servidor.
# Nunca coloque uma chave real em arquivo versionado.
PASSWORD_RECOVERY_PROVIDER=none
PASSWORD_RECOVERY_URL=
# Para pentest-lab: https://loadx-system.vercel.app/password-reset
RESEND_API_KEY=
# Endereço remetente de domínio de sua propriedade e verificado no Resend.
RESEND_SENDER=
SMTP_SECURITY=ssl
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# OC98 / #222: recurso disponível por padrão no projeto; cada usuário precisa optar por confiar.
# Ambientes podem sobrescrever com TRUSTED_DEVICES_ENABLED=false.
TRUSTED_DEVICES_ENABLED=true
TRUSTED_DEVICE_DAYS=30

# OC109: processo separado; WhatsApp permanece mock.
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_SECONDS=30
OUTBOX_CAP_SECONDS=3600
OUTBOX_POLL_SECONDS=2
